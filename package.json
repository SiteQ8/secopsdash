{
  "name": "secopsdash",
  "version": "1.0.0",
  "description": "Open-Source Security Operations Dashboard - Your SOC Command Center",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0",
    "framer-motion": "^10.16.0",
    "lucide-react": "^0.294.0",
    "react-hot-toast": "^2.4.1",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "gh-pages": "^6.1.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^8.0.5",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "security",
    "soc",
    "dashboard",
    "cybersecurity",
    "threat-intelligence",
    "vulnerability-management",
    "compliance",
    "incident-response",
    "siem",
    "security-operations",
    "react",
    "typescript",
    "tailwind"
  ],
  "author": {
    "name": "Ali Al-Mutairi",
    "email": "ali@3li.info",
    "url": "https://3li.info"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SiteQ8/secopsdash.git"
  },
  "bugs": {
    "url": "https://github.com/SiteQ8/secopsdash/issues"
  },
  "homepage": "https://secopsdash.3li.info",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
